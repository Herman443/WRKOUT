# Copy to .env.local for local development; set the same keys in Vercel → Settings → Environment Variables.
# Generate all secrets with: npm run setup:secrets

# Public base URL (used for OAuth redirects and notification links)
APP_URL=http://localhost:3000
APP_TIMEZONE=Europe/Oslo

# Supabase Postgres. Runtime uses the transaction pooler (port 6543);
# migrations use the direct/session connection (port 5432).
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-north-1.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-north-1.pooler.supabase.com:5432/postgres

# Login: npm run hash-password -- "your password"
APP_PASSWORD_HASH=
SESSION_SECRET=
# Bearer token for /api/cron/tick (used by Supabase pg_cron)
CRON_SECRET=
# 32 random bytes, base64 — encrypts stored OAuth tokens
TOKEN_ENCRYPTION_KEY=

# Claude API. Direct: a key from console.anthropic.com (set a monthly spend limit there).
# Through a gateway such as Netlight's LiteLLM proxy, also set the base URL:
#   ANTHROPIC_BASE_URL=https://llm.netlight.ai
# ANTHROPIC_AUTH_TOKEN works instead of ANTHROPIC_API_KEY. Check with: npm run check:claude
ANTHROPIC_API_KEY=
# Only if the endpoint names models differently (see npm run check:claude)
# COACH_MODEL=claude-opus-5-5
# Only if the endpoint rejects server-side refusal fallbacks (also detected automatically)
# CLAUDE_SERVER_FALLBACKS=off

# Garmin Connect → Settings → Personal API (valid up to 1 year)
GARMIN_API_KEY=
GARMIN_API_KEY_EXPIRES=2027-11-13

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: Strava webhook trigger (needs a Strava API app)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
